{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pilot7-review-api",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "vars": {
    "SITE_URL": "https://rconsortium.github.io/submissions-pilot7-synthetic-data/",
    "SERVICE_URL": "https://REPLACE-WITH-YOUR-WORKER.workers.dev",
    "GITHUB_CLIENT_ID": "REPLACE-WITH-YOUR-GITHUB-APP-CLIENT-ID"
  },
  "durable_objects": {
    "bindings": [{"name": "REVIEW_API", "class_name": "ReviewApi"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ReviewApi"]}],
  "observability": {"enabled": false}
}
