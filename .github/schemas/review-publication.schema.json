{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed publication scope for dataset versus Define-XML",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_sha256",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "disposition",
          "reason"
        ],
        "properties": {
          "disposition": {
            "enum": [
              "finding",
              "clarification",
              "coverage",
              "exclude"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "basis": {
            "type": "string",
            "pattern": "^(sha256:)?[a-f0-9]{64}$"
          },
          "group": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
