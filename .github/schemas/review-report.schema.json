{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "review-report.schema.json",
  "title": "review-report",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "study": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "minLength": 1
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "issues": {
          "type": "integer",
          "minimum": 0
        },
        "checks": {
          "type": "integer",
          "minimum": 0
        },
        "evidence": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["issues", "checks", "evidence"]
    }
  },
  "required": [
    "schema_version",
    "study",
    "revision",
    "issues",
    "checks",
    "evidence",
    "counts"
  ],
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "conflict",
            "divergence",
            "gap",
            "evidence",
            "inconsistent",
            "unclear",
            "missing_evidence",
            "not_reviewed"
          ]
        },
        "comparison": {
          "enum": ["input_output", "source_documents", "documented_rules"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "observed": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "check_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "trace": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trace"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "impact": {
          "$ref": "#/$defs/impact"
        },
        "review": {
          "enum": [
            "agreed",
            "disputed",
            "stale",
            "pending",
            "mixed",
            "not_reviewed"
          ]
        }
      },
      "required": [
        "id",
        "dataset",
        "variable",
        "kind",
        "comparison",
        "title",
        "summary",
        "expected",
        "observed",
        "action",
        "check_ids",
        "trace",
        "impact",
        "review"
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dataset": {
          "type": "string",
          "minLength": 1
        },
        "variable": {
          "type": "string"
        },
        "kind": {
          "enum": [
            "conflict",
            "divergence",
            "gap",
            "evidence",
            "inconsistent",
            "unclear",
            "missing_evidence",
            "not_reviewed"
          ]
        },
        "comparison": {
          "enum": ["input_output", "source_documents", "documented_rules"]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "title": {
                  "type": "string",
                  "minLength": 1
                },
                "statement": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": ["id", "title", "statement"]
            },
            {
              "type": "null"
            }
          ]
        },
        "review": {
          "$ref": "#/$defs/review"
        },
        "basis": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "dataset",
        "variable",
        "kind",
        "comparison",
        "title",
        "summary",
        "rule",
        "review",
        "basis",
        "evidence_ids"
      ]
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": ["impact", "context"]
        }
      },
      "required": ["evidence_id", "role"]
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": ["observed", "not_observed", "not_measured"]
        },
        "subject_count": {
          "type": "integer",
          "minimum": 0
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["status", "subject_count", "subjects"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decision": {
          "enum": ["agree", "dispute", "stale", "pending", "not_reviewed"]
        },
        "reason": {
          "type": "string"
        }
      },
      "required": ["decision", "reason"]
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reference": {
          "type": ["string", "number", "boolean", "null"]
        },
        "observed": {
          "type": ["string", "number", "boolean", "null"]
        },
        "row": {
          "enum": ["matched", "extra", "absent"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["reference", "observed", "row", "count", "subjects"]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": ["string", "number", "boolean", "null"]
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["value", "count", "subjects"]
    },
    "evidence": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "enum": ["document", "specification"]
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "section": {
              "type": "string"
            },
            "quote": {
              "type": "string"
            },
            "context": {
              "type": "string"
            },
            "lines": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "context_lines": {
              "anyOf": [
                {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "integer",
                      "minimum": 1
                    },
                    {
                      "type": "integer",
                      "minimum": 1
                    }
                  ],
                  "items": false,
                  "minItems": 2
                },
                {
                  "type": "null"
                }
              ]
            },
            "url": {
              "type": "string"
            },
            "verified": {
              "type": "boolean"
            },
            "reason": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "id",
            "type",
            "title",
            "path",
            "section",
            "quote",
            "context",
            "lines",
            "context_lines",
            "url",
            "verified",
            "reason"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "comparison"
            },
            "method": {
              "enum": ["probe", "copy"]
            },
            "column": {
              "type": "string",
              "minLength": 1
            },
            "reading": {
              "type": "string"
            },
            "target": {
              "enum": ["reference", "derived"]
            },
            "compared": {
              "type": "integer",
              "minimum": 0
            },
            "differ": {
              "type": "integer",
              "minimum": 0
            },
            "patterns": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/pattern"
              },
              "minItems": 0
            },
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": [
            "id",
            "type",
            "method",
            "column",
            "reading",
            "target",
            "compared",
            "differ",
            "patterns",
            "subjects"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "codelist"
            },
            "codelist": {
              "type": "string",
              "minLength": 1
            },
            "target": {
              "enum": ["reference", "derived"]
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              },
              "minItems": 0
            },
            "subjects": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          },
          "required": ["id", "type", "codelist", "target", "values", "subjects"]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "type": {
              "const": "note"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          },
          "required": ["id", "type", "title", "text"]
        }
      ]
    }
  }
}
