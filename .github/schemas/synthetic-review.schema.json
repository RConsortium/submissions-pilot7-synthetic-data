{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Synthetic study analysis coverage and open review findings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study", "review_state", "assumptions", "findings", "coverage"],
  "properties": {
    "schema_version": {"const": 1},
    "study": {"type": "string"},
    "review_state": {"const": "awaiting_human_review"},
    "assumptions": {"type": "string"},
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "coverage": {"type": "array", "items": {"$ref": "#/$defs/coverage"}}
  },
  "$defs": {
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "severity", "status", "title", "summary", "datasets", "proposed_action", "citations", "measurement", "choices", "human_resolution"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]+$"},
        "kind": {"enum": ["gap", "conflict", "decision"]},
        "severity": {"enum": ["high", "medium", "low"]},
        "status": {"const": "open"},
        "title": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "datasets": {"type": "array", "items": {"type": "string"}},
        "proposed_action": {"type": "string", "minLength": 1},
        "citations": {"type": "array", "items": {"$ref": "#/$defs/citation"}},
        "measurement": {"type": ["string", "null"]},
        "choices": {"type": "array", "items": {"type": "string"}},
        "human_resolution": {"type": "null"}
      }
    },
    "citation": {
      "type": "object", "additionalProperties": false,
      "required": ["document", "section", "line", "quote"],
      "properties": {
        "document": {"type": "string", "pattern": "^spec/source/[^.][^\\\\]*$"},
        "section": {"type": "string"}, "line": {"type": "integer", "minimum": 1},
        "quote": {"type": "string", "minLength": 1}
      }
    },
    "coverage": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "analysis", "status", "datasets", "supported_scope", "findings"],
      "properties": {
        "id": {"type": "string"}, "analysis": {"type": "string"},
        "status": {"enum": ["supported", "partial", "unsupported"]},
        "datasets": {"type": "array", "items": {"type": "string"}},
        "supported_scope": {"type": "string"},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
