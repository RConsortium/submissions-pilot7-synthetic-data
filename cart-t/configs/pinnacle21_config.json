{
  "validation_config": {
    "rules": {
      "sdtm": {
        "version": "SDTMIG v3.3",
        "exclude_rules": [],
        "severity_threshold": "Warning",
        "datasets": ["dm", "ae", "cm", "ds", "ie", "lb", "mh", "qs", "ce"]
      },
      "adam": {
        "version": "ADaMIG v1.3",
        "exclude_rules": [],
        "severity_threshold": "Warning",
        "datasets": ["adsl", "adae", "adcm", "adlb", "adqs", "admh", "adds", "adie", "adce"]
      }
    },
    "output": {
      "formats": ["json", "html"],
      "include_passed": false,
      "detailed_messages": true
    },
    "github_integration": {
      "create_issues": true,
      "issue_labels": ["pinnacle21", "validation-failure", "automated"],
      "fail_conditions": {
        "error_count": 0,
        "warning_threshold": 50
      }
    }
  },
  "issue_templates": {
    "title_format": "[Pinnacle 21] {validation_type} Validation Failure: {check_id} - {rule}",
    "priority_mapping": {
      "Error": "high",
      "Warning": "medium",
      "Info": "low"
    },
    "assignees": [],
    "auto_close_on_fix": true
  }
}