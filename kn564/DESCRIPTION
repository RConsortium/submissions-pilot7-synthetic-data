Package: kn564
Title: KEYNOTE-564 IPD Causal-DAG Simulator
Version: 0.1.0
Description: Simulates individual patient data for KEYNOTE-564 (NCT03142334),
    a Phase 3 trial of adjuvant pembrolizumab in clear-cell RCC post-nephrectomy.
    Uses a causal DAG structural causal model to generate realistic IPD with
    calibration to published trial results.
Authors@R: person("Simulator", "Author", role = c("aut", "cre"))
License: MIT
Encoding: UTF-8
Depends:
    R (>= 4.1.0)
Imports:
    survival,
    data.table,
    jsonlite,
    mvtnorm
Suggests:
    testthat (>= 3.0.0),
    ggplot2,
    survminer
Config/testthat/edition: 3
